{
    "python.defaultInterpreterPath": "${workspaceFolder}/brewery-scraper/.venv/Scripts/python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/brewery-scraper"
    ],
    "python.testing.pytestArgs": [],
    "python.testing.cwd": "${workspaceFolder}/brewery-scraper",
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "ruff.path": [
        "${workspaceFolder}/brewery-scraper/.venv/Scripts/ruff.exe"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    }
}
